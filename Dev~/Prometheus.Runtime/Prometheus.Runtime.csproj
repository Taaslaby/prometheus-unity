<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Prometheus.Runtime</AssemblyName>
    <RootNamespace>Prometheus.Runtime</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>CS1591;CS1573;CS1572</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!-- Исходники берём прямо из пакета: dotnet-инструменты проверяют тот же
       код, который увидит Unity. Unity-слой (Runtime/Unity) сюда не входит —
       он требует UnityEngine, а Core обязан быть чистым (noEngineReferences).
       Dev~ невидима для Unity, поэтому bin/obj не попадают в импорт. -->
  <ItemGroup>
    <Compile Include="..\..\Runtime\Core\**\*.cs" />
  </ItemGroup>

</Project>
